datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  MIXED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ExpenseCategory {
  VEGETABLES
  MILK
  GAS
  CLEANING
  PETROL
  MISCELLANEOUS
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shifts       Shift[]   @relation("CashierShifts")
  approvedShifts Shift[] @relation("ApprovedShifts")
  expenses     Expense[]
  orders       Order[]

  @@index([email])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dishes      Dish[]
}

model Dish {
  id              String      @id @default(uuid())
  name            String      @unique
  description     String?
  price           Decimal     @db.Decimal(10, 2)
  taxRate         Decimal     @default(0.00) @db.Decimal(5, 2)
  isAvailable     Boolean     @default(true)
  preparationTime Int         @default(15) // in minutes
  imageUrl        String?
  categoryId      String
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category        Category    @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]

  @@index([categoryId])
}

model Table {
  id        String      @id @default(uuid())
  number    String      @unique
  capacity  Int
  status    TableStatus @default(AVAILABLE)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders    Order[]
}

model Shift {
  id                String      @id @default(uuid())
  cashierId         String
  openingCash       Decimal     @db.Decimal(10, 2)
  closingCashSales  Decimal?    @db.Decimal(10, 2)
  closingCardSales  Decimal?    @db.Decimal(10, 2)
  closingUpiSales   Decimal?    @db.Decimal(10, 2)
  closingExpenses   Decimal?    @db.Decimal(10, 2)
  expectedCash      Decimal?    @db.Decimal(10, 2)
  actualCash        Decimal?    @db.Decimal(10, 2)
  cashDifference    Decimal?    @db.Decimal(10, 2)
  actualUpi         Decimal?    @db.Decimal(10, 2)
  upiDifference     Decimal?    @db.Decimal(10, 2)
  openingTime       DateTime    @default(now())
  closingTime       DateTime?
  status            ShiftStatus @default(OPEN)
  approvedById      String?
  closingNotes      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  cashier           User        @relation("CashierShifts", fields: [cashierId], references: [id])
  approvedBy        User?       @relation("ApprovedShifts", fields: [approvedById], references: [id])
  orders            Order[]

  @@index([cashierId])
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   Int         @unique @default(autoincrement())
  tableId       String?
  cashierId     String
  shiftId       String
  status        OrderStatus @default(PENDING)
  type          OrderType
  subtotal      Decimal     @db.Decimal(10, 2)
  taxTotal      Decimal     @db.Decimal(10, 2)
  discountTotal Decimal     @default(0.00) @db.Decimal(10, 2)
  grandTotal    Decimal     @db.Decimal(10, 2)
  customerName  String?
  customerPhone String?
  isHeld        Boolean     @default(false)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByName    String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  table         Table?      @relation(fields: [tableId], references: [id])
  cashier       User        @relation(fields: [cashierId], references: [id])
  shift         Shift       @relation(fields: [shiftId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([tableId])
  @@index([cashierId])
  @@index([shiftId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  dishId    String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  taxRate   Decimal  @db.Decimal(5, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id])

  @@index([orderId])
  @@index([dishId])
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  status    PaymentStatus @default(COMPLETED)
  details   Json?         // To store credit card transaction references, UPI transaction IDs, or Mixed breakdown
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Expense {
  id        String          @id @default(uuid())
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  notes     String?
  date      DateTime        @default(now())
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
}

model PartyHall {
  id          String             @id @default(uuid())
  name        String             @unique
  capacity    Int
  baseRent    Decimal            @db.Decimal(10, 2)
  description String?
  isActive    Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  bookings    PartyHallBooking[]
}

model PartyHallCustomer {
  id        String             @id @default(uuid())
  name      String
  mobile    String             @unique
  altMobile String?
  email     String?
  address   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  bookings  PartyHallBooking[]
}

model PartyHallBooking {
  id               String              @id @default(uuid())
  bookingNumber    Int                 @unique @default(autoincrement())
  customerId       String
  hallId           String
  eventType        String
  bookingDate      DateTime
  startTime        String
  endTime          String
  guestCount       Int
  status           String              @default("RESERVED") // RESERVED, BOOKED, CANCELLED
  hallRent         Decimal             @db.Decimal(10, 2)
  decorCharges     Decimal             @default(0.00) @db.Decimal(10, 2)
  foodCharges      Decimal             @default(0.00) @db.Decimal(10, 2)
  soundCharges     Decimal             @default(0.00) @db.Decimal(10, 2)
  generatorCharges Decimal             @default(0.00) @db.Decimal(10, 2)
  cleaningCharges  Decimal             @default(0.00) @db.Decimal(10, 2)
  extraCharges     Decimal             @default(0.00) @db.Decimal(10, 2)
  discount         Decimal             @default(0.00) @db.Decimal(10, 2)
  gst              Decimal             @default(0.00) @db.Decimal(10, 2)
  grandTotal       Decimal             @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customer         PartyHallCustomer   @relation(fields: [customerId], references: [id])
  hall             PartyHall           @relation(fields: [hallId], references: [id])
  services         PartyHallService[]
  payments         PartyHallPayment[]
  invoices         PartyHallInvoice[]

  @@index([customerId])
  @@index([hallId])
}

model PartyHallService {
  id        String           @id @default(uuid())
  bookingId String
  name      String
  cost      Decimal          @db.Decimal(10, 2)
  booking   PartyHallBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PartyHallPayment {
  id        String           @id @default(uuid())
  bookingId String
  amount    Decimal          @db.Decimal(10, 2)
  method    String           // CASH, CARD, UPI, BANK_TRANSFER
  notes     String?
  date      DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  booking   PartyHallBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PartyHallInvoice {
  id            String           @id @default(uuid())
  invoiceNumber Int              @unique @default(autoincrement())
  bookingId     String
  createdAt     DateTime         @default(now())
  booking       PartyHallBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PartyHallActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Game {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  pricings    GamePricing[]
  sessions    GameSession[]
}

model GamePricing {
  id        String        @id @default(uuid())
  gameId    String
  name      String        // e.g. "30 Minutes", "60 Minutes", "₹100 Package"
  duration  Int           // in minutes (0 if package without fixed duration)
  price     Decimal       @db.Decimal(10, 2)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sessions  GameSession[]

  @@index([gameId])
}

model GameCustomer {
  id        String        @id @default(uuid())
  name      String
  mobile    String        @unique
  age       Int
  gender    String        // MALE, FEMALE, OTHER
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  GameSession[]
}

model GameSession {
  id             String            @id @default(uuid())
  sessionId      Int               @unique @default(autoincrement())
  customerId     String
  gameId         String
  pricingId      String
  guestCount     Int               @default(1)
  entryTime      DateTime          @default(now())
  exitTime       DateTime?
  status         String            @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes          String?
  originalPrice  Decimal           @db.Decimal(10, 2) // snapshot of pricing
  discount       Decimal           @default(0.00) @db.Decimal(10, 2)
  extraCharges   Decimal           @default(0.00) @db.Decimal(10, 2)
  gst            Decimal           @default(0.00) @db.Decimal(10, 2)
  grandTotal     Decimal           @db.Decimal(10, 2)
  overrideUser   String?           // Username or ID of the manager who authorized override
  overrideReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       GameCustomer      @relation(fields: [customerId], references: [id])
  game           Game              @relation(fields: [gameId], references: [id])
  pricing        GamePricing       @relation(fields: [pricingId], references: [id])
  payments       GamePayment[]
  invoices       GameInvoice[]
  activityLogs   GameActivityLog[]

  @@index([customerId])
  @@index([gameId])
  @@index([pricingId])
}

model GamePayment {
  id        String      @id @default(uuid())
  sessionId String
  amount    Decimal     @db.Decimal(10, 2)
  method    String      // CASH, CARD, UPI, BANK_TRANSFER, MIXED
  notes     String?
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model GameInvoice {
  id            String      @id @default(uuid())
  invoiceNumber Int         @unique @default(autoincrement())
  sessionId     String
  createdAt     DateTime    @default(now())
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model GameActivityLog {
  id        String       @id @default(uuid())
  userId    String
  sessionId String?
  action    String       // CREATE_SESSION, CLOSE_SESSION, PRICE_OVERRIDE, etc.
  details   String?
  createdAt DateTime     @default(now())
  session   GameSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}
